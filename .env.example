# Copy to .env (git-ignored) and fill in. Every variable is documented in docs/specs/ERS.md §5.

# --- Environment -------------------------------------------------------------
COHORTEX_ENV=local                      # local | ci | demo

# --- Postgres + pgvector (docker compose) -----------------------------------
POSTGRES_USER=cohortex
POSTGRES_PASSWORD=cohortex-local-only   # local development only; never reuse in the demo
POSTGRES_DB=cohortex
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cohortex:cohortex-local-only@localhost:5432/cohortex

# --- Kafka (KRaft) -----------------------------------------------------------
KAFKA_HOST_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092 # from the host; containers use kafka:9092

# --- Data ---------------------------------------------------------------------
RAW_DATA_URI=./data/raw
COHORTEX_WINDOW_QUARTERS=6
# Optional: Backblaze's public read-only Iceberg copy of Drive Stats.
# Keys are published on https://www.backblaze.com/cloud-storage/resources/hard-drive-test-data
BACKBLAZE_ICEBERG_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_ICEBERG_BUCKET=drivestats-iceberg
BACKBLAZE_ICEBERG_KEY_ID=
BACKBLAZE_ICEBERG_APP_KEY=

# --- Services -------------------------------------------------------------------
FLEET_API_URL=http://localhost:8080
AGENT_API_URL=http://localhost:8000
MCP_FLEET_URL=http://localhost:8101/mcp
MCP_STATS_URL=http://localhost:8102/mcp

# --- LLM (agent-service, judge) -------------------------------------------------
# $0 budget (ADR-013): only free-tier or local OpenAI-compatible endpoints.
#   Groq free tier : LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-20b
#   Local Ollama   : LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen3:1.7b  (LLM_API_KEY=ollama; 1.4 GB, CPU-friendly; qwen3:4b if quality is too low)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=                            # free Groq key from console.groq.com; never commit it
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=qwen/qwen3.8-27b            # different family from the agent model (ADR-013)
JUDGE_API_KEY=
LLM_MAX_OUTPUT_TOKENS=4096              # cap per call; free tiers count output against tokens/min
LLM_REASONING_EFFORT=medium             # gpt-oss on Groq: low sometimes yields unparseable tool calls
LLM_TPM_LIMIT=8000                      # Groq free tier tokens/min; output cap shrinks so prompt+output fits
LLM_MAX_ATTEMPTS=6                      # 429 retries honor Retry-After; the free tier resets each minute
COHORTEX_LLM_MODE=live                  # live | record | replay (CI uses replay)
COHORTEX_RECORDINGS_DIR=evals/recordings
COHORTEX_MAX_TOOL_CALLS=20
COHORTEX_MAX_INPUT_TOKENS=40000         # Groq free tier: 8K tokens/min; raise to 150000 for local Ollama
COHORTEX_MAX_SECONDS=600               # Groq free tier throttles to 8K tokens/min; 180 on local or paid
COHORTEX_MONTHLY_LLM_CAP_USD=0          # $0 budget; paid endpoints are refused while this is 0

# --- Embeddings (corpus-indexer, mcp-docs) --------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # run locally with fastembed, no API (ADR-013)
EMBEDDING_DIM=384                       # must equal the model's vector size (Flyway placeholder)

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
COHORTEX_CAPTURE_CONTENT=false

# --- Demo ----------------------------------------------------------------------------
ADMIN_TOKEN=
