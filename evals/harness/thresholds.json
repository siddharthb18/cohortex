{
  "_source": "docs/specs/evaluation.md section 1. Never change a threshold to make CI pass (CLAUDE.md).",
  "golden_version": "v1",
  "regression_points": 0.03,
  "regression_metrics": ["M1", "M2", "M3", "M6"],
