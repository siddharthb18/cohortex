{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet.smart_trend input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "model",
    "attr",
    "from",
    "to"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "backblaze",
        "alibaba"
      ],
      "description": "Dataset: backblaze (HDD) or alibaba (SSD)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9_.\\- ]{0,63}$",
      "description": "Drive model name exactly as listed by list_models, e.g. ST12000NM000J."
    },
    "attr": {
      "type": "integer",
      "enum": [
        5,
        9,
        12,
        171,
        172,
        173,
        174,
        175,
        187,
        188,
        193,
        194,
        195,
        197,
        198,
        199,
        240,
        241,
        242
      ],
      "description": "SMART attribute id. backblaze: [5, 9, 12, 187, 188, 193, 194, 197, 198, 199, 240, 241, 242]; alibaba: [5, 9, 12, 171, 172, 173, 174, 175, 187, 188, 194, 195, 199]."
    },
    "from": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window start, inclusive (YYYY-MM-DD)."
    },
    "to": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window end, inclusive (YYYY-MM-DD)."
    },
    "granularity": {
      "type": "string",
      "enum": [
        "quarter",
        "month"
      ],
      "default": "quarter",
      "description": "Period size: quarter (YYYYQn) or month (YYYY-MM)."
    },
    "page": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999,
      "default": 0,
      "description": "0-based page index of a result split to fit 4 KB; a result's next_page names the following page."
    }
  }
}
