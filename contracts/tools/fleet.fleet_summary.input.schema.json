{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet.fleet_summary input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "from",
    "to"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "backblaze",
        "alibaba"
      ],
      "description": "Dataset: backblaze (HDD) or alibaba (SSD)."
    },
    "from": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window start, inclusive (YYYY-MM-DD)."
    },
    "to": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window end, inclusive (YYYY-MM-DD)."
    }
  }
}
