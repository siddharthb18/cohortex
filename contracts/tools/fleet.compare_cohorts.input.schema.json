{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet.compare_cohorts input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "from",
    "to"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "backblaze",
        "alibaba"
      ],
      "description": "Dataset: backblaze (HDD) or alibaba (SSD)."
    },
    "from": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window start, inclusive (YYYY-MM-DD)."
    },
    "to": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Window end, inclusive (YYYY-MM-DD)."
    },
    "min_drives": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000,
      "default": 60,
      "description": "A model qualifies when its drive_count on its last day in the window is at least this."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20,
      "description": "Number of ranked models (at most 20)."
    },
    "page": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999,
      "default": 0,
      "description": "0-based page index of a result split to fit 4 KB; a result's next_page names the following page."
    }
  }
}
